_site
.sass-cache
.jekyll-metadata
.idea/
.vscode/
.DS_Store

# Local dependency lockfile — GitHub Pages doesn't use it,
# and tracking it triggers spurious Dependabot alerts.
Gemfile.lock

# Node / build artifacts (just in case)
node_modules/

# Local image backups (kept on disk, not published)
images/*.original.*
images/*.bak

# Source PDFs kept locally for reference; published copies live under assets/
doc/*.pdf

# Local scratch space (drafts, prompts, working notes) — never published
tmp/
